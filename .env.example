# Teacher Antigravity Environment Settings
# Do not commit the actual .env file, this is an example template

APP_ENV=development

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL_ID=gemini-2.5-flash
GEMINI_REASONING_MODEL_ID=gemini-2.5-pro

# Ollama Configuration
OLLAMA_FALLBACK_MODEL_ID=llama3
OLLAMA_REASONING_MODEL_ID=deepseek-coder
OLLAMA_API_BASE=http://localhost:11434

# Stability controls
MAX_RETRIES=2
TIMEOUT_SECONDS=30
RATE_LIMIT_RPM=60
RATE_LIMIT_TPM=100000

# Safety Level (strict, moderate, lenient)
SAFETY_LEVEL=strict
